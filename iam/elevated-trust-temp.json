{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyTheBrokerHoldsThisExternalId",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::750240012171:root" },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "sts:ExternalId": "REPLACE_WITH_CLAWOPS_EXTERNAL_ID"
        }
      }
    }
  ]
}
