{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyTouchOwnInstances",
      "Effect": "Allow",
      "Action": [
        "ec2:TerminateInstances",
        "ec2:StopInstances",
        "ec2:StartInstances",
        "ec2:RebootInstances"
      ],
      "Resource": "arn:aws:ec2:*:750240012171:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/ManagedBy": "ClawOps",
          "aws:RequestedRegion": ["me-central-1", "ap-south-1"]
        }
      }
    },
    {
      "Sid": "ReadSoItCanConfirmItsOwnWork",
      "Effect": "Allow",
      "Action": ["ec2:Describe*"],
      "Resource": "*"
    }
  ]
}
