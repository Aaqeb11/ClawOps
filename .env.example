# ClawOps — configuration reference
#
# There is no single .env. Three separate surfaces, three destinations. Copying
# this whole file to one place will not work; take the section you need.
#
#   1. NanoClaw runtime   ->  ~/nanoclaw/.env          (NOT this repo)
#   2. Approval broker    ->  exported in the broker's own shell
#   3. AWS credentials    ->  ./.aws-credentials       (INI, not env)
#
# Nothing here is a secret. Every real value is gitignored.


# ─────────────────────────────────────────────────────────────────────────────
# 1. NanoClaw runtime            destination: ~/nanoclaw/.env
# ─────────────────────────────────────────────────────────────────────────────
#
# NanoClaw reads .env from its OWN project root (src/env.ts: projectRoot +
# '/.env'), so this belongs in ~/nanoclaw/.env. A copy in this repo is ignored.
# apply.sh preserves it -- `git clean -fd` without -x leaves ignored files alone.

# Slack channel. Without these the adapter logs "Channel credentials missing,
# skipping" at boot and the agent is reachable only over the local cli channel.
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# Socket Mode (xapp-...). Set it and events arrive over an outbound WebSocket,
# so no public HTTPS endpoint is needed -- the right choice on a laptop or an
# EC2 box with no inbound rule. Omit it and Slack expects a webhook URL.
SLACK_APP_TOKEN=xapp-...

# Model selection for the OpenCode provider.
#
# NOTE: no API key goes here. OpenCode authenticates through NanoClaw's gateway
# (`Gateway provider selected gatewayProvider="onecli"` in the boot log), and
# the container is handed `apiKey: 'placeholder'` with the gateway's base URL.
# Model credentials are configured during `pnpm setup` in ~/nanoclaw, not here.
#
# OPENCODE_PROVIDER defaults to 'anthropic'. Set 'openai' to route an
# OpenAI-compatible endpoint (this is the seam an OpenRouter base URL uses) --
# the provider then loads @ai-sdk/openai-compatible.
OPENCODE_PROVIDER=anthropic
OPENCODE_MODEL=anthropic/claude-opus-5

# Cheaper model for summarisation and other background turns. Optional.
OPENCODE_SMALL_MODEL=anthropic/claude-haiku-4-5-20251001

# Anthropic-compatible proxy base URL. Optional; leave unset for the default.
# ANTHROPIC_BASE_URL=

# Only needed when a model's real limits are not what the SDK assumes. Optional.
# OPENCODE_MODEL_CONTEXT_LIMIT=
# OPENCODE_MODEL_OUTPUT_LIMIT=
# OPENCODE_MODEL_INPUT_MODALITIES=


# ─────────────────────────────────────────────────────────────────────────────
# 2. Approval broker             destination: the broker process's environment
# ─────────────────────────────────────────────────────────────────────────────
#
# These two are the reason the approval gate is real rather than advisory. The
# broker runs as its own process and the agent must never see them -- an agent
# holding CLAWOPS_EXTERNAL_ID could assume the elevated role by itself and the
# human approval step would be decoration.
#
# So: export these in the shell that starts `yarn broker`. Do NOT put them in
# ~/nanoclaw/.env, which is readable by the agent's container.

# The role in iam/elevated-perms.json.
CLAWOPS_ELEVATED_ROLE_ARN=arn:aws:iam::750240012171:role/clawops-elevated

# Must match the sts:ExternalId condition in iam/elevated-trust-temp.json.
# Generate one: openssl rand -hex 32
CLAWOPS_EXTERNAL_ID=

# Defaults to 7171. The broker binds loopback only and is never exposed.
# CLAWOPS_BROKER_PORT=7171

# Where the agent looks for the broker. Default http://127.0.0.1:7171
# CLAWOPS_BROKER_URL=


# ─────────────────────────────────────────────────────────────────────────────
# 3. AWS credentials             destination: ./.aws-credentials  (INI format)
# ─────────────────────────────────────────────────────────────────────────────
#
# NOT env vars, and not this file. agent/SKILL.md runs the CLI with
# AWS_SHARED_CREDENTIALS_FILE=./.aws-credentials, which expects INI:
#
#   [default]
#   aws_access_key_id = ...
#   aws_secret_access_key = ...
#   region = ap-south-1
#
# The console exports a .tsv/.csv -- convert it, don't rename it. Save as
# `.aws-credentials` with no extension, then delete the export.
#
# These keys must carry iam/agent-readonly.json and nothing more. If `stop`
# ever succeeds without an approval, the wrong keys are in this file.

# Region both the CLI and the broker act in. Defaults to ap-south-1.
AWS_REGION=ap-south-1
