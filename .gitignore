.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Whether you use PnP or not, the node_modules folder is often used to store
# build artifacts that should be gitignored
node_modules

# Swap the comments on the following lines if you wish to use zero-installs
# In that case, don't forget to run `yarn config set enableGlobalCache false`!
# Documentation here: https://yarnpkg.com/features/caching#zero-installs

#!.yarn/cache
.pnp.*

# build output
dist/

# Agent AWS credentials - never commit.
# Glob, not the exact name: console exports land as .tsv/.csv and an exact-name
# rule silently leaves those tracked.
.aws-credentials*

# Secrets of every other shape
.env
.env.*
!.env.example

# Broker approval database. Runtime state, not source -- committing it puts
# real approval records in git and conflicts on every pull.
clawops.db
*.db-journal

# This repo is Yarn 4 (see packageManager). An npm lockfile alongside
# yarn.lock means two resolvers disagreeing about the same tree.
package-lock.json

.DS_Store
